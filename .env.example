# ---- Voltage Payments -------------------------------------------------------
# Server-only. Never prefixed with NEXT_PUBLIC_ and never sent to the browser.
# From the Voltage dashboard: an environment-scoped API key with WRITE access.
VOLTAGE_API_KEY=
VOLTAGE_ORGANIZATION_ID=
VOLTAGE_ENVIRONMENT_ID=
# The wallet deposits are received into.
VOLTAGE_WALLET_ID=

# Optional. Enables the session-gated autopay demo helper, which lets you settle
# an invoice without a mutinynet wallet on hand. Must be a funded wallet in the
# SAME environment, so the payment short-circuits instead of touching Lightning.
# Leave unset and the route 404s and the button never renders.
# VOLTAGE_TREASURY_WALLET_ID=

# Optional. Defaults to https://voltageapi.com/v1
# A staging key does not authenticate against production: it answers
# `missing_credentials`, not 401. Point this at staging if your key is staging's.
# VOLTAGE_API_BASE=https://staging.voltageapi.com/v1

# ---- Google OAuth -----------------------------------------------------------
# Web application credentials from console.cloud.google.com.
# Authorized redirect URIs must include, for each origin you run on:
#   http://localhost:8888/api/auth/google/callback
#   https://<your-site>.netlify.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie and the OAuth state. openssl rand -base64 32
AUTH_SECRET=

# Optional. Only needed if the forwarded host is wrong behind a proxy; the
# origin is otherwise derived from the request.
# APP_ORIGIN=https://jungle-jackpot.netlify.app

# ---- Deposit policy ---------------------------------------------------------
# The whole point of the demo. Both caps are enforced per Google account.
LIMIT_DEPOSITS_PER_DAY=7
LIMIT_SATS_PER_DAY=10000
# utc_day  = hard reset at 00:00 UTC (what the reference demo does)
# rolling  = trailing 24 hours from now
LIMIT_WINDOW=utc_day

MIN_DEPOSIT_SATS=100
MAX_DEPOSIT_SATS=5000
INVOICE_EXPIRY_SECONDS=900

# ---- Tagging ----------------------------------------------------------------
# Written to metadata.app on every invoice, and used to scope the ledger query
# so one Voltage environment can host several demos without them interfering.
APP_TAG=jungle-jackpot
