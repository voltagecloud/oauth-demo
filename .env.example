# ---- Voltage Payments -------------------------------------------------------
# Server-only. Never prefixed with NEXT_PUBLIC_ and never sent to the browser.
# From the Voltage dashboard: an environment-scoped API key with WRITE access.
VOLTAGE_API_KEY=
VOLTAGE_ORGANIZATION_ID=
VOLTAGE_ENVIRONMENT_ID=
# The wallet deposits are received into.
VOLTAGE_WALLET_ID=

# The wallet's currency, network and line of credit are READ FROM THE API:
# GET /wallets/{id} for the network and line of credit, then
# GET /lines_of_credit/{id}/summary for the currency. You do not need to set
# any of the three variables below.
#
# They exist only as overrides, for a key that cannot read wallets. Setting one
# by hand creates a way for the app and the wallet to disagree — and when they
# disagree nothing errors: a USD wallet read as bitcoin renders $100.00 as
# "10 sats" and skips the conversion quote that makes its invoices work at all.
#
# VOLTAGE_CURRENCY=usd            # btc | usd
# VOLTAGE_NETWORK=mutinynet       # mainnet | testnet | signet | mutinynet | none
# VOLTAGE_LINE_OF_CREDIT_ID=

# Optional. Enables the session-gated autopay demo helper, which lets you settle
# an invoice without a wallet on hand. Must be a funded wallet in the SAME
# environment, so the payment short-circuits instead of touching Lightning.
# Leave unset and the route 404s and the button never renders.
# VOLTAGE_TREASURY_WALLET_ID=

# Optional. Defaults to https://voltageapi.com/v1
# An API key is bound to the host that issued it; presenting one to a different
# host fails with `missing_credentials`, not 401. Set this only if Voltage gave
# you a base URL other than the default.
# VOLTAGE_API_BASE=

# ---- Google OAuth -----------------------------------------------------------
# Web application credentials from console.cloud.google.com/auth/clients.
# Authorized redirect URIs must include, for each origin you run on:
#   http://localhost:8888/api/auth/google/callback
#   https://<your-site>.netlify.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. openssl rand -base64 32
AUTH_SECRET=

# Optional. Only needed if the forwarded host is wrong behind a proxy; the
# origin is otherwise derived from the request.
# APP_ORIGIN=https://jungle-jackpot.netlify.app

# ---- Deposit policy ---------------------------------------------------------
# The whole point of the demo. Both caps are enforced per Google account.
#
# EVERY AMOUNT BELOW IS IN THE WALLET CURRENCY'S BASE UNIT, matching what the
# Voltage API itself takes and returns:
#
#   a USD wallet  ->  cents   (10000 = $100.00)
#   a BTC wallet  ->  msats   (10000 = 10 sats)
#
# These two have no default on purpose. They are the thing the demo exists to
# show, and a default standing in for missing configuration is indistinguishable
# from a real policy on screen — you end up debugging the wrong system.
LIMIT_DEPOSITS_PER_DAY=3
LIMIT_AMOUNT_PER_DAY=10000

# utc_day = hard reset at 00:00 UTC (what the reference demo does)
# rolling = trailing 24 hours from now
LIMIT_WINDOW=utc_day

# Per-deposit bounds, also in base units. Default to 100 / 5000 for usd and
# 100000 / 5000000 for btc.
# MIN_DEPOSIT_AMOUNT=
# MAX_DEPOSIT_AMOUNT=

INVOICE_EXPIRY_SECONDS=900

# ---- Tagging ----------------------------------------------------------------
# Written to metadata.app on every invoice, and used to scope the ledger query
# so one Voltage environment can host several demos without them interfering.
APP_TAG=jungle-jackpot
